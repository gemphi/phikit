    def Scope "Materials"
    {
        def Material "gold"
        {
            token outputs:surface.connect = </petal_dome/Materials/gold/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68668544, 0.45078585, 0.10702311)
                float inputs:roughness = 0.3
                float inputs:metallic = 1
                token outputs:surface
            }

        }

