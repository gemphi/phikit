#usda 1.0
(
    defaultPrim = "octahedron"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "octahedron"
{
    def Mesh "body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.06, -0.06, -0.06), (0.06, 0.06, 0.06)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3, 4, 1, 0, 3, 1, 4, 2, 5, 0, 3, 5, 2, 0, 5, 4, 4, 5, 3]
        point3f[] points = [(0, 0, 0.06), (0.06, 0, 0), (0, 0.06, 0), (0, 0, -0.06), (0, -0.06, 0), (-0.06, 0, 0)]
        normal3f[] normals = [(0.57735026, 0.57735026, 0.57735026), (0.57735026, 0.57735026, 0.57735026), (0.57735026, 0.57735026, 0.57735026), (0.57735026, 0.57735026, -0.57735026), (0.57735026, 0.57735026, -0.57735026), (0.57735026, 0.57735026, -0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, -0.57735026, -0.57735026), (0.57735026, -0.57735026, -0.57735026), (0.57735026, -0.57735026, -0.57735026), (-0.57735026, 0.57735026, 0.57735026), (-0.57735026, 0.57735026, 0.57735026), (-0.57735026, 0.57735026, 0.57735026), (-0.57735026, 0.57735026, -0.57735026), (-0.57735026, 0.57735026, -0.57735026), (-0.57735026, 0.57735026, -0.57735026), (-0.57735026, -0.57735026, 0.57735026), (-0.57735026, -0.57735026, 0.57735026), (-0.57735026, -0.57735026, 0.57735026), (-0.57735026, -0.57735026, -0.57735026), (-0.57735026, -0.57735026, -0.57735026), (-0.57735026, -0.57735026, -0.57735026)] (
            interpolation = "faceVarying"
        )
        color3f[] primvars:displayColor = [(0.35, 0.8, 0.85)] (
            interpolation = "constant"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </octahedron/Materials/body>
    }

    def Scope "Materials"
    {
        def Material "body"
        {
            token outputs:surface.connect = </octahedron/Materials/body/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.8, 0.85)
                float inputs:roughness = 0.4
                float inputs:metallic = 0
                token outputs:surface
            }

        }

    }

}
