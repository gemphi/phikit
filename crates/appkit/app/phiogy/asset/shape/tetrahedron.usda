#usda 1.0
(
    defaultPrim = "tetrahedron"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "tetrahedron"
{
    def Mesh "body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.034641016, -0.034641016, -0.034641016), (0.034641016, 0.034641016, 0.034641016)]
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 3, 1, 0, 2, 1, 3, 3, 0, 2]
        point3f[] points = [(-0.034641016, -0.034641016, 0.034641016), (0.034641016, 0.034641016, 0.034641016), (-0.034641016, 0.034641016, -0.034641016), (0.034641016, -0.034641016, -0.034641016)]
        normal3f[] normals = [(-0.57735026, 0.57735026, 0.57735026), (-0.57735026, 0.57735026, 0.57735026), (-0.57735026, 0.57735026, 0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, -0.57735026, 0.57735026), (0.57735026, 0.57735026, -0.57735026), (0.57735026, 0.57735026, -0.57735026), (0.57735026, 0.57735026, -0.57735026), (-0.57735026, -0.57735026, -0.57735026), (-0.57735026, -0.57735026, -0.57735026), (-0.57735026, -0.57735026, -0.57735026)] (
            interpolation = "faceVarying"
        )
        color3f[] primvars:displayColor = [(0.95, 0.4, 0.55)] (
            interpolation = "constant"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </tetrahedron/Materials/body>
    }

    def Scope "Materials"
    {
        def Material "body"
        {
            token outputs:surface.connect = </tetrahedron/Materials/body/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.4, 0.55)
                float inputs:roughness = 0.4
                float inputs:metallic = 0
                token outputs:surface
            }

        }

    }

}
