# Large production .blend assets (copied from phi/crates/phiphx/assets)
#crates/phiber/assets/production/

# Reference trees live outside the repo, in gemphi/ext (moved by gemphi/move-refs.ps1).
/REFS/
/crates/phiber/refs/
/crates/phiber/docs/blender-manual/

# phiber never commits Blender files or heavy 3D assets: they stay on disk only.
# Exception: assets/blend/ holds the startup templates the build compiles in
# (include_bytes! in src/v2/scene/template.rs); without them a clone does not build.
*.blend1
/crates/phiber/**/*.blend
!/crates/phiber/assets/blend/*.blend
/crates/phiber/assets/production/
/crates/phiber/assets/CW-Fashion/
